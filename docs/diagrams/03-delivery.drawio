        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Push to main&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A merge to main in the GitHub repository starts the deploy workflow.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend">
          <mxGeometry x="48" y="0" width="408" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="146" width="460" height="88" as="geometry" />
        </mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Build, test, scan&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Docker builds an ARM64 image; unit tests run in the build stage, then a smoke test, a Trivy scan and an SBOM. This job has no AWS access.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend">
          <mxGeometry x="48" y="0" width="408" height="88" as="geometry" />
        </mxCell>
        <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="242" width="460" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Push job gets credentials&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;OIDC exchanges the GitHub token for a short-lived IAM role. No stored access keys.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend">
          <mxGeometry x="48" y="0" width="408" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="302" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Push by digest&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The scanned image goes to Amazon ECR; the job records its sha256 digest and a build provenance attestation.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend">
          <mxGeometry x="48" y="0" width="408" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="380" width="460" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Deploy that digest&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;After production approval, terraform apply sets the task image to repo@sha256:digest.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend">
          <mxGeometry x="48" y="0" width="408" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="440" width="460" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Tasks pull the exact image&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Amazon ECS pulls the image by digest, never by a mutable tag.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend">
          <mxGeometry x="48" y="0" width="408" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="500" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-7-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;(a) Rolling update (default)&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ECS replaces tasks gradually; the deployment circuit breaker and CloudWatch alarms roll back a bad release.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend">
          <mxGeometry x="48" y="0" width="408" height="70" as="geometry" />
        </mxCell>
        <mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="578" width="460" height="88" as="geometry" />
        </mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-8-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;(b) Blue/green (optional)&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;AWS CodeDeploy starts green tasks behind the test listener :9443, shifts 10% of traffic for 5 minutes, then the rest; it rolls back on alarm.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend">
          <mxGeometry x="48" y="0" width="408" height="88" as="geometry" />
        </mxCell>
        <mxCell id="step-9-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1870" y="674" width="460" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-9-legend">
          <mxGeometry x="0" y="2" width="36" height="32" as="geometry" />
        </mxCell>
        <mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Verify&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;verify-deployment.sh waits for rollout COMPLETED, then checks HTTPS /health and the deployed version.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend">
          <mxGeometry x="48" y="0" width="408" height="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-notes" value="Choose (a) or (b) per environment; both end in the same verification." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" vertex="1" parent="1">
