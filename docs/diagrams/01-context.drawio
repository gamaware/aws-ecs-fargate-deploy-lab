        <mxCell id="step-1-desc-legend" value='&lt;div&gt;&lt;b&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Customers query stock&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Browser and app clients of Harbor Goods call the API over HTTPS.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="48" y="0" width="328" height="52" as="geometry" /></mxCell>
